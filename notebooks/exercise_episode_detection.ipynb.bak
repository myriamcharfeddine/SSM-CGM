    "try:\n",
    "    import pyarrow\n",
    "    HAS_PYARROW = True\n",
    "except ImportError:\n",
    "    HAS_PYARROW = False\n",
    "\n",
    "try:\n",
    "    from scipy import stats as sp_stats\n",
    "    HAS_SCIPY = True\n",
    "except ImportError:\n",
