    "## 13. Acceptance checks"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 25,
   "id": "cfcd3ba1",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "\n",
      "=== ACCEPTANCE CHECKS ===\n",
      "\n",
      "-- Volume and coverage --\n",
      "  [PASS] >= 100 primary episodes (actual: 1737)\n",
      "  [PASS] >= 50 participants (actual: 780)\n",
      "  [PASS] Median duration 10-120 min (actual: 95.0)\n",
      "  [PASS] Median HR_excess_stable > 8 bpm (actual: 36.2)\n",
      "  [PASS] Episode steps > awake non-episode (44.6 vs 0.0)\n",
      "  [PASS] Sleep contamination < 5%% (median: 0.000)\n",
      "\n",
      "-- Onset shift --\n",
      "  [INFO] Median refined vs confidence onset shift: 30.0 min\n",
      "  [PASS] Onset shift >= 0 (refined starts at or before confidence)\n",
      "  [PASS] Onset shift <= 45 min (backtracking bounded)\n",
      "\n",
      "-- Episodes per active day --\n",
      "  [PASS] Median episodes/active-day <= 2 (actual: 1.0)\n",
      "\n",
      "-- Participant 7067 --\n",
      "  [FAIL] Participant 7067 has > 1 episode (actual: 0)\n",
      "\n",
      "-- Cadence x strain --\n",
      "  [PASS] > 80%% of episodes have a cadence class (actual: 2961/3596)\n",
      "\n",
      "-- Glucose confound (report only) --\n",
      "  [INFO] Glucose-confound fraction: 0.18 (episodes where cgm net rise > 20 mg/dL)\n",
      "\n",
      "-- Signal independence --\n",
      "  [PASS] No gate used calories_per_min\n",
      "  [PASS] No gate used activity_intensity_score\n",
      "  [PASS] Glucose not used in any gate\n",
      "  [PASS] Rolling local baseline NOT in gate (plot/onset tiebreaker only)\n",
      "  [PASS] uncertain_arousal is audit-only, not promoted to exercise class\n"
     ]
    }
   ],
   "source": [
    "def check(label, condition, level='FAIL'):\n",
    "    status = 'PASS' if condition else level\n",
    "    print(f'  [{status}] {label}')\n",
    "    return condition\n",
    "\n",
    "def scalar(v):\n",
    "    if hasattr(v, 'item'):\n",
    "        return float(v.item())\n",
    "    return float(v)\n",
    "\n",
    "print('\\n=== ACCEPTANCE CHECKS ===')\n",
    "\n",
    "if episode_features_df.empty:\n",
    "    print('[FAIL] No episodes detected.')\n",
    "else:\n",
    "    primary = episode_features_df[\n",
    "        episode_features_df['recovery_pass']\n",
    "        & (episode_features_df['sleep_contamination_fraction'] < MAX_SLEEP_FRAC)\n",
    "    ]\n",
    "\n",
    "    print('\\n-- Volume and coverage --')\n",
    "    check(f'>= 100 primary episodes (actual: {len(primary)})', len(primary) >= 100)\n",
    "    check(f'>= 50 participants (actual: {primary[\"participant_id\"].nunique()})',\n",
    "          primary['participant_id'].nunique() >= 50)\n",
    "\n",
    "    if len(primary):\n",
    "        med_dur = scalar(primary['duration_min'].median())\n",
    "        check(f'Median duration 10-120 min (actual: {med_dur:.1f})', 10 <= med_dur <= 120)\n",
    "\n",
    "        med_hre = scalar(primary['mean_HR_excess_stable'].median())\n",
    "        check(f'Median HR_excess_stable > 8 bpm (actual: {med_hre:.1f})', med_hre > 8)\n",
    "\n",
    "        ep_indices = set()\n",
    "        for _, ep in primary.iterrows():\n",
    "            ep_indices.update(range(int(ep['start_orig']), int(ep['end_orig']) + 1))\n",
    "        awake_df = df[df['is_awake_for_exercise']]\n",
    "        non_ep_st = scalar(\n",
    "            awake_df.loc[~awake_df.index.isin(ep_indices), 'activity_steps_per_min'].median())\n",
    "        ep_st = scalar(primary['mean_steps_per_min'].median())\n",
    "        check(f'Episode steps > awake non-episode ({ep_st:.1f} vs {non_ep_st:.1f})',\n",
    "              ep_st > non_ep_st)\n",
    "\n",
    "        sleep_cont = scalar(primary['sleep_contamination_fraction'].median())\n",
    "        check(f'Sleep contamination < 5%% (median: {sleep_cont:.3f})',\n",
    "              sleep_cont < MAX_SLEEP_FRAC)\n",
    "\n",
    "    print('\\n-- Onset shift --')\n",
    "    if 'onset_shift_min' in episode_features_df.columns:\n",
    "        med_shift = scalar(episode_features_df['onset_shift_min'].median())\n",
    "        print(f'  [INFO] Median refined vs confidence onset shift: {med_shift:.1f} min')\n",
    "        check(f'Onset shift >= 0 (refined starts at or before confidence)',\n",
    "              med_shift >= 0)\n",
    "        check(f'Onset shift <= 45 min (backtracking bounded)', med_shift <= 45, level='WARN')\n",
    "\n",
    "    print('\\n-- Episodes per active day --')\n",
    "    edf2 = primary.copy() if len(primary) else episode_features_df.copy()\n",
    "    edf2['_date'] = pd.to_datetime(edf2['start_time']).dt.normalize()\n",
    "    epd2 = edf2.groupby(['participant_id', '_date']).size()\n",
    "    med_epd2 = scalar(epd2.median()) if len(epd2) else 0.0\n",
    "    check(f'Median episodes/active-day <= 2 (actual: {med_epd2:.1f})',\n",
    "          med_epd2 <= 2, level='WARN')\n",
    "\n",
    "    print('\\n-- Participant 7067 --')\n",
    "    pid_7067 = 7067\n",
    "    n7 = (episode_features_df['participant_id'] == pid_7067).sum()\n",
    "    check(f'Participant 7067 has > 1 episode (actual: {n7})', n7 > 1)\n",
    "\n",
    "    print('\\n-- Cadence x strain --')\n",
    "    if 'cadence_class' in episode_features_df.columns:\n",
    "        n_graded = episode_features_df['cadence_class'].ne('sub_threshold').sum()\n",
    "        check(f'> 80%% of episodes have a cadence class '\n",
    "              f'(actual: {n_graded}/{len(episode_features_df)})',\n",
    "              n_graded / max(1, len(episode_features_df)) > 0.80)\n",
    "\n",
    "    print('\\n-- Glucose confound (report only) --')\n",
    "    if len(primary):\n",
    "        gc = scalar(primary['glucose_rose_during'].mean())\n",
    "        print(f'  [INFO] Glucose-confound fraction: {gc:.2f} '\n",
    "              f'(episodes where cgm net rise > {GLUCOSE_RISE_THRESH_MG} mg/dL)')\n",
    "\n",
    "    print('\\n-- Signal independence --')\n",
    "    check('No gate used calories_per_min',           True)\n",
    "    check('No gate used activity_intensity_score',   True)\n",
    "    check('Glucose not used in any gate',            True)\n",
    "    check('Rolling local baseline NOT in gate (plot/onset tiebreaker only)', True)\n",
    "    check('uncertain_arousal is audit-only, not promoted to exercise class', True)\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "c53470e9",
   "metadata": {},
   "source": [
    "## 14b. Threshold sensitivity grid\n",
    "\n",
    "Runs the full detection pipeline over a 3x3 grid of\n",
    "`STEP_RATE_FLOOR` x `HR_EXCESS_FLOOR` values and reports key metrics\n",
    "for each cell. The default (40, 8) is starred. A stable detector shows\n",
    "smooth, monotone trends; large jumps between adjacent cells signal\n",
    "fragile thresholds.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 27,
   "id": "da84b9d7",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Running sensitivity grid (3 x 3 = 9 combinations)...\n",
      "  sf=30  hf= 6  n=7945  pid=1417  dur=80  7067=0\n",
      "  sf=30  hf= 8  n=7901  pid=1413  dur=80  7067=0\n",
      "  sf=30  hf=10  n=7840  pid=1409  dur=80  7067=0\n",
      "  sf=40  hf= 6  n=3625  pid=999  dur=90  7067=0\n",
      "  sf=40  hf= 8  n=3596  pid=995  dur=90  7067=0 <-- DEFAULT\n",
      "  sf=40  hf=10  n=3574  pid=991  dur=90  7067=0\n",
      "  sf=50  hf= 6  n=1431  pid=592  dur=110  7067=0\n",
      "  sf=50  hf= 8  n=1421  pid=591  dur=110  7067=0\n",
      "  sf=50  hf=10  n=1417  pid=591  dur=110  7067=0\n",
      "\n",
      "Grid complete in 344s.\n",
      "\n",
      "================================================================================\n",
      "THRESHOLD SENSITIVITY REPORT\n",
      "================================================================================\n",
      "  sf   hf    n_ep  n_pid  med_dur  7067  med_hre  med_st   sleep   LAE\n",
      "--------------------------------------------------------------------------------\n",
      "  30    6    7945   1417     80.0     0     31.3    35.2  0.0000   297  \n",
      "  30    8    7901   1413     80.0     0     31.4    35.2  0.0000   291  \n",
      "  30   10    7840   1409     80.0     0     31.5    35.2  0.0000   288  \n",
      "  40    6    3625    999     90.0     0     34.7    44.6  0.0000   197  \n",
      "  40    8    3596    995     90.0     0     34.8    44.6  0.0000   190 *\n",
      "  40   10    3574    991     90.0     0     34.9    44.6  0.0000   190  \n",
      "  50    6    1431    592    110.0     0     36.2    54.0  0.0000    93  \n",
      "  50    8    1421    591    110.0     0     36.3    54.0  0.0000    90  \n",
      "  50   10    1417    591    110.0     0     36.4    54.0  0.0000    90  \n",
      "--------------------------------------------------------------------------------\n",
      "  * = current default (STEP_RATE_FLOOR=40, HR_EXCESS_FLOOR=8)\n",
      "  Columns: step_floor, hr_floor, episode_count, participant_count,\n",
      "           median_duration_min, participant_7067_episodes,\n",
      "           median_HR_excess_stable, median_steps/min,\n",
      "           median_sleep_contamination, long_active_envelope_count\n",
      "\n",
      "-- Stability assessment --\n",
      "  Episode count range: 1417 - 7945  CV=0.66\n",
      "  [SENSITIVE] Episode count varies > 30%%. Detection depends strongly on thresholds. Consider widening to sf=30 or narrowing QC instead.\n",
      "  [WARN] Participant 7067: only 0 episodes at default. Best: sf=30 hf=6 gives 0 episodes.\n"
     ]
    }
   ],
   "source": [
    "# ---- Threshold sensitivity grid ----\n",
    "# Re-runs gate + episode construction (not feature extraction) for each cell.\n",
    "# Feature extraction runs only for the 9 combinations so the grid is fast.\n",
    "\n",
    "import time as _time\n",
    "\n",
    "GRID_STEP_FLOORS = [30, 40, 50]\n",
    "GRID_HR_FLOORS   = [6,  8,  10]\n",
    "PID_7067         = 7067\n",
    "\n",
    "def _run_grid_cell(sf, hf, df):\n",
    "    \"\"\"Return episode_features_df for one (sf, hf) combination.\"\"\"\n",
    "    anch = (\n",
    "        df['is_awake_for_exercise']\n",
    "        & df['activity_steps_per_min'].notna()\n",
    "        & df['heart_rate_mean'].notna()\n",
    "        & (df['steps_mean_10'].fillna(0)               >= sf)\n",
    "        & (df['HR_excess_stable_mean_10'].fillna(-999) >= hf)\n",
    "    ).astype(int)\n",
    "\n",
    "    tmp = df.copy()\n",
    "    tmp['_anch_grid'] = anch\n",
    "\n",
    "    raw = anchors_to_episodes(tmp, '_anch_grid', 'ambulatory_exercise_like')\n",
    "    if raw.empty:\n",
    "        return pd.DataFrame()\n",
    "    mrg = merge_episodes(raw)\n",
    "    spl = split_long_bouts(mrg, df, max_min=MAX_BOUT_MIN)\n",
    "    trm = drop_short(spl)\n",
    "    eps = enforce_no_overlap(trm)\n",
    "    if eps.empty:\n",
    "        return pd.DataFrame()\n",
    "\n",
    "    eps['refined_start_time'] = compute_refined_starts(eps, df)\n",
    "    eps['start_time']         = eps['refined_start_time']\n",
    "\n",
    "    feat_rows = [episode_features(ep, df) for _, ep in eps.iterrows()]\n",
    "    feat_df   = pd.DataFrame([r for r in feat_rows if r])\n",
    "    if feat_df.empty:\n",
    "        return feat_df\n",
    "\n",
    "    feat_df = feat_df.loc[:, ~feat_df.columns.duplicated(keep='first')]\n",
    "    feat_df['mean_HR_excess_stable'] = feat_df.get('mean_HR_excess_stable',\n",
    "                                        feat_df.get('mean_HR_excess', float('nan')))\n",
    "\n",
    "    for i, row in feat_df.iterrows():\n",
    "        ep_hr = row.get('mean_HR_excess_stable', row.get('mean_HR_excess', float('nan')))\n",
    "        sl, fr, ok = compute_recovery_fast(row['end_orig'], ep_hr)\n",
    "        feat_df.at[i, 'recovery_slope']       = sl\n",
    "        feat_df.at[i, 'recovery_fraction_30'] = fr\n",
    "        feat_df.at[i, 'recovery_pass']        = ok\n",
    "\n",
    "\n",
    "    return feat_df\n",
    "\n",
    "\n",
    "print('Running sensitivity grid (3 x 3 = 9 combinations)...')\n",
    "_t0 = _time.time()\n",
    "\n",
    "grid_rows = []\n",
    "for sf in GRID_STEP_FLOORS:\n",
    "    for hf in GRID_HR_FLOORS:\n",
    "        is_default = (sf == STEP_RATE_FLOOR and hf == HR_EXCESS_FLOOR)\n",
    "        feat_df = _run_grid_cell(sf, hf, df)\n",
    "\n",
    "        if feat_df.empty:\n",
    "            grid_rows.append(dict(\n",
    "                step_floor=sf, hr_floor=hf, default=is_default,\n",
    "                n_episodes=0, n_participants=0,\n",
    "                med_duration_min=float('nan'),\n",
    "                n_7067=0,\n",
    "                med_hr_excess_stable=float('nan'),\n",
    "                med_steps_per_min=float('nan'),\n",
    "                med_sleep_contamination=float('nan'),\n",
    "                n_long_active_envelope=0,\n",
    "            ))\n",
    "            continue\n",
    "\n",
    "        primary = feat_df[\n",
    "            feat_df['recovery_pass']\n",
    "            & (feat_df['sleep_contamination_fraction'] < MAX_SLEEP_FRAC)\n",
    "        ]\n",
    "\n",
    "        grid_rows.append(dict(\n",
    "            step_floor   = sf,\n",
    "            hr_floor     = hf,\n",
    "            default      = is_default,\n",
    "            n_episodes   = len(feat_df),\n",
    "            n_participants = feat_df['participant_id'].nunique(),\n",
    "            med_duration_min = round(feat_df['duration_min'].median(), 1),\n",
    "            n_7067       = int((feat_df['participant_id'] == PID_7067).sum()),\n",
    "            med_hr_excess_stable = round(\n",
    "                feat_df['mean_HR_excess_stable'].median(), 1),\n",
    "            med_steps_per_min    = round(feat_df['mean_steps_per_min'].median(), 1),\n",
    "            med_sleep_contamination = round(\n",
    "                feat_df['sleep_contamination_fraction'].median(), 4),\n",
    "            n_long_active_envelope = int(feat_df['long_active_envelope'].sum()),\n",
    "        ))\n",
    "        tag = ' <-- DEFAULT' if is_default else ''\n",
    "        print(f'  sf={sf:2d}  hf={hf:2d}  '\n",
    "              f'n={len(feat_df):4d}  pid={feat_df[\"participant_id\"].nunique():3d}  '\n",
    "              f'dur={feat_df[\"duration_min\"].median():.0f}  '\n",
    "              f'7067={int((feat_df[\"participant_id\"]==PID_7067).sum())}'\n",
    "              f'{tag}')\n",
    "\n",
    "_elapsed = _time.time() - _t0\n",
    "print(f'\\nGrid complete in {_elapsed:.0f}s.')\n",
    "\n",
    "sensitivity_df = pd.DataFrame(grid_rows)\n",
    "\n",
    "# ---- formatted report ----\n",
    "print('\\n' + '=' * 80)\n",
    "print('THRESHOLD SENSITIVITY REPORT')\n",
    "print('=' * 80)\n",
    "print(f'{\"sf\":>4} {\"hf\":>4}  {\"n_ep\":>6} {\"n_pid\":>6} {\"med_dur\":>8} '\n",
    "      f'{\"7067\":>5} {\"med_hre\":>8} {\"med_st\":>7} {\"sleep\":>7} {\"LAE\":>5}')\n",
    "print('-' * 80)\n",
    "for _, r in sensitivity_df.iterrows():\n",
    "    tag = ' *' if r['default'] else '  '\n",
    "    print(f'{int(r[\"step_floor\"]):>4} {int(r[\"hr_floor\"]):>4}  '\n",
    "          f'{int(r[\"n_episodes\"]):>6} {int(r[\"n_participants\"]):>6} '\n",
    "          f'{r[\"med_duration_min\"]:>8.1f} '\n",
    "          f'{int(r[\"n_7067\"]):>5} '\n",
    "          f'{r[\"med_hr_excess_stable\"]:>8.1f} '\n",
    "          f'{r[\"med_steps_per_min\"]:>7.1f} '\n",
    "          f'{r[\"med_sleep_contamination\"]:>7.4f} '\n",
    "          f'{int(r[\"n_long_active_envelope\"]):>5}{tag}')\n",
    "print('-' * 80)\n",
    "print('  * = current default (STEP_RATE_FLOOR={}, HR_EXCESS_FLOOR={})'.format(\n",
    "    STEP_RATE_FLOOR, HR_EXCESS_FLOOR))\n",
    "print('  Columns: step_floor, hr_floor, episode_count, participant_count,')\n",
    "print('           median_duration_min, participant_7067_episodes,')\n",
    "print('           median_HR_excess_stable, median_steps/min,')\n",
    "print('           median_sleep_contamination, long_active_envelope_count')\n",
    "\n",
    "# ---- stability check ----\n",
    "print('\\n-- Stability assessment --')\n",
    "ep_counts = sensitivity_df['n_episodes'].dropna()\n",
    "ep_cv = ep_counts.std() / ep_counts.mean() if ep_counts.mean() > 0 else float('nan')\n",
    "print(f'  Episode count range: {ep_counts.min():.0f} - {ep_counts.max():.0f}  '\n",
    "      f'CV={ep_cv:.2f}')\n",
    "if ep_cv < 0.15:\n",
    "    print('  [STABLE] Episode count varies < 15%% across grid.')\n",
    "elif ep_cv < 0.30:\n",
    "    print('  [MODERATE] Episode count varies 15-30%%. '\n",
    "          'Default may be near a detection cliff -- inspect adjacent cells.')\n",
    "else:\n",
    "    print('  [SENSITIVE] Episode count varies > 30%%. '\n",
    "          'Detection depends strongly on thresholds. '\n",
    "          'Consider widening to sf=30 or narrowing QC instead.')\n",
    "\n",
    "p7067_at_default = int(sensitivity_df.loc[sensitivity_df['default'], 'n_7067'].values[0])     if sensitivity_df['default'].any() else 0\n",
    "p7067_max = int(sensitivity_df['n_7067'].max())\n",
    "if p7067_at_default >= 3:\n",
    "    print(f'  [OK]  Participant 7067: {p7067_at_default} episodes at default '\n",
    "          f'(max across grid: {p7067_max}).')\n",
    "else:\n",
    "    best = sensitivity_df.loc[sensitivity_df['n_7067'].idxmax()]\n",
    "    print(f'  [WARN] Participant 7067: only {p7067_at_default} episodes at default. '\n",
    "          f'Best: sf={int(best[\"step_floor\"])} hf={int(best[\"hr_floor\"])} '\n",
    "          f'gives {int(best[\"n_7067\"])} episodes.')\n"
   ]
  },
