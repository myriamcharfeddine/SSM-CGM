   "source": [
    "print('\\n=== FINAL RECOMMENDATION ===')\n",
    "\n",
    "if episode_features_df.empty:\n",
    "    print('[ACTION] No episodes detected. Reduce STEP_RATE_FLOOR or HR_EXCESS_FLOOR.')\n",
    "else:\n",
    "    primary = episode_features_df[\n",
    "        episode_features_df['recovery_pass']\n",
    "        & (episode_features_df['sleep_contamination_fraction'] < MAX_SLEEP_FRAC)\n",
    "    ]\n",
    "    n_primary = len(primary)\n",
    "    n_pid     = primary['participant_id'].nunique() if len(primary) else 0\n",
    "    pid_7067  = 7067\n",
    "    n7        = (episode_features_df['participant_id'] == pid_7067).sum()\n",
    "    med_dur   = primary['duration_min'].median() if len(primary) else 0\n",
    "\n",
    "    all_pass = (\n",
    "        n_primary >= 100\n",
    "        and n_pid  >= 50\n",
    "        and 10 <= med_dur <= 120\n",
    "        and n7 >= 3\n",
    "    )\n",
    "\n",
    "    if all_pass:\n",
    "        print('[PROCEED] Primary episodes pass all acceptance checks.')\n",
    "        print('  Proceed to Stage 2 residual diagnostic.')\n",
    "    else:\n",
    "        print('[REVIEW] One or more checks failing:')\n",
    "        if n_primary < 100:\n",
    "            print(f'  Primary episodes {n_primary} < 100.')\n",
    "        if n_pid < 50:\n",
    "            print(f'  Participants {n_pid} < 50.')\n",
    "        if not (10 <= med_dur <= 120):\n",
    "            print(f'  Median duration {med_dur:.1f} min outside 10-120.')\n",
    "        if n7 < 3:\n",
    "            print(f'  Participant 7067: {n7} episodes (expected >= 3).')\n",
    "\n",
    "    print(f'\\n  Primary: {n_primary} episodes, {n_pid} participants')\n",
    "    print(f'  Participant 7067: {n7} episodes')\n",
    "    print(f'  Median duration: {med_dur:.1f} min')\n",
    "    shift_med = episode_features_df[\"onset_shift_min\"].median() if \"onset_shift_min\" in episode_features_df.columns else float(\"nan\")\n",
    "    print(f'  Median onset shift (confidence - refined): {shift_med:.1f} min')\n"
   ]
